{
    "compilerOptions": {
        // General
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "target": "ESNext",
        // Modules
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        // Type Checking & Safety
        "strict": true,
        "types": [
            "vite/client"
        ],
        "paths": {
            "@/pages": [
                "./src/pages"
            ],
            "@/utils": [
                "./src/utils"
            ],
            "@/consts": [
                "./src/consts"
            ],
            "@/components": [
                "./src/components"
            ],
            "@/assets/*": [
                "./src/assets/*"
            ]
        }
    }
}